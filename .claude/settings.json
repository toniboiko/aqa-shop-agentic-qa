{
  "permissions": {
    "deny": [
      "Edit(test-cases/**)",
      "Write(test-cases/**)",
      "MultiEdit(test-cases/**)",
      "NotebookEdit(test-cases/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-check-file.mjs\""
          }
        ]
      }
    ]
  }
}
