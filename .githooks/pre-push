#!/bin/bash
# Direct pushes to main are blocked: changes go through a pull request.
while read -r _ _ remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main is blocked. Create a branch and open a pull request." >&2
    exit 1
  fi
done

# Changed tests need a fresh test-reviewer ACCEPT in reviews/ (see scripts/review-gate.mjs).
node scripts/review-gate.mjs check
